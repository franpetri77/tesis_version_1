# =============================================
# VARIABLES DE ENTORNO - BACKEND TELE IMPORT
# Copiar este archivo a .env y completar los valores reales.
# NUNCA commitear el archivo .env al repositorio.
# =============================================

# Puerto del servidor Express
PORT=4000

# URL del frontend (para URLs de retorno de Mercado Pago)
FRONTEND_URL=http://localhost:3000

# Orígenes permitidos por CORS — separados por coma si hay más de uno.
# En producción (Render): CORS_ORIGINS=https://sctechnology.vercel.app
CORS_ORIGINS=http://localhost:3000

# URL pública del backend (para el webhook de Mercado Pago)
BACKEND_URL=http://localhost:4000

# =============================================
# BASE DE DATOS MYSQL
# =============================================
# Host del servidor MySQL (en producción: IP o hostname del servidor)
DB_HOST=localhost

# Puerto MySQL (por defecto 3306)
DB_PORT=3306

# Usuario MySQL
DB_USER=root

# Contraseña MySQL (cambiar en producción)
DB_PASSWORD=

# Nombre de la base de datos (debe existir, las tablas se crean automáticamente)
DB_NAME=tele_import

# SSL hacia la base (sólo si el proveedor lo exige; la red privada de Railway no lo usa).
# Con DB_SSL=true el certificado se verifica. DB_SSL_CA: certificado de la autoridad (PEM).
# DB_SSL_REJECT_UNAUTHORIZED=false desactiva la verificación (no recomendado).
# DB_SSL=true
# DB_SSL_CA=
# DB_SSL_REJECT_UNAUTHORIZED=true

# =============================================
# AUTENTICACIÓN JWT
# =============================================
# Clave secreta para firmar tokens JWT — cambiar en producción por una cadena aleatoria larga.
# Con NODE_ENV=production el servidor no arranca si falta o si usa este valor de ejemplo.
JWT_SECRET=tele-import-dev-secret-2024

# Saltos de proxy en los que se confía para obtener la IP real del visitante
# (límite de intentos del login y auditoría). En Railway: 1. Local: sin definir.
# TRUST_PROXY=1

# =============================================
# EMAIL / SMTP (verificación de cuenta y recuperación de contraseña)
# =============================================
# Ejemplo con Gmail (requiere "Contraseña de aplicación", no la normal):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=tucuenta@gmail.com
#   SMTP_PASS=xxxx xxxx xxxx xxxx   (app password de 16 dígitos)
#   SMTP_FROM=Tele Import <tucuenta@gmail.com>
# Si se dejan vacías, el sistema NO envía correos: registra el link en
# la consola del backend (útil para desarrollo/demo).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Tele Import <no-reply@teleimport.com>

# =============================================
# MERCADO PAGO
# =============================================
# Access token de la app de MP (usar credenciales de sandbox para desarrollo)
MP_ACCESS_TOKEN=

# Clave secreta para verificar la firma de los webhooks de MP
# Configurar en el dashboard de MP > Notificaciones
MP_WEBHOOK_SECRET=

# =============================================
# (OPCIONAL) TOKEN INTERNO DE SERVICIO
# =============================================
# Token para proteger rutas internas llamadas desde el frontend server-side
# Si no se configura, las rutas internas no requieren autenticación (útil en dev)
INTERNAL_SERVICE_TOKEN=
